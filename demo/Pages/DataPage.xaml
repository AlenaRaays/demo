<Page x:Class="demo.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" VerticalAlignment="Center" Margin="20,0"></TextBox>

            <Grid Grid.Column="1" Margin="50,0">
                <ComboBox Name="Sortbox" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Margin="30, 0"></ComboBox>
                <ComboBox  Name="Filterbox" VerticalAlignment="Center" HorizontalAlignment="Right" Width="100" Margin="30, 0"></ComboBox>
            </Grid>
        </Grid>
        
        
        <ListView Grid.Row="1" Name="ProductList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding CurrentImage}" Width="100" Height="100"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <StackPanel>
                                <TextBlock Text="{Binding producNname}" FontSize="15" FontWeight="DemiBold"/>
                                <TextBlock>
                                    <Run Text="Категория: "/>
                                    <Run Text="{Binding Category.category1}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Grid  Grid.Column="2" Margin="50, 0">
                            <TextBlock Text="{Binding price}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
