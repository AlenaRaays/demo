<Page x:Class="demo.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="DataPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Name="SearchBox" Grid.Column="0" VerticalAlignment="Center" Margin="20,0" TextChanged="SortFilterSearch"/>

            <Grid Grid.Column="1">
                <ComboBox FontFamily="Calibri" Name="Sortbox" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Margin="30, 0" SelectionChanged="SortFilterSearch"></ComboBox>
                <ComboBox FontFamily="Calibri" Name="Filterbox" VerticalAlignment="Center" HorizontalAlignment="Right" Width="100" Margin="30, 0" SelectionChanged="SortFilterSearch" ></ComboBox>
            </Grid>
            <Grid Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
                <TextBlock FontFamily="Calibri" x:Name="loginedName" TextWrapping="Wrap" Visibility="Hidden"/>
                <TextBlock FontFamily="Calibri" x:Name="loginLink" Visibility="Hidden">
                    <Hyperlink Click="loginLink_Click">
                        Войти
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Grid>
        
        
        <ListView Grid.Row="1" Name="ProductList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding ColorAmo}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding CurrentImage}" Width="100" Height="100"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5">
                                <StackPanel Width="500">
                                    <TextBlock FontFamily="Calibri" TextWrapping="Wrap" FontSize="15" FontWeight="DemiBold" HorizontalAlignment="Center" TextAlignment="Center">
                                        <Run Text="{Binding Manufacture.manufacturer}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding producNname}"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Calibri" TextWrapping="Wrap">
                                        <Run Text="Категория: "/>
                                        <Run Text="{Binding Category.category1}"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Calibri" TextWrapping="Wrap" FontSize="12">
                                        <Run Text="Количество: "/>
                                        <Run Text="{Binding AmountWord}"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Calibri" TextWrapping="Wrap" FontSize="10">
                                        <Run Text="Состав: "/>
                                        <Run Text="{Binding consists}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Grid  Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100">
                                <TextBlock FontFamily="Calibri" Text="{Binding price}" FontSize="20"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
