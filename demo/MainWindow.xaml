<Window x:Class="demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800"
        MinHeight="500" MinWidth="800"
        MaxHeight="500" MaxWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>
        <Frame Grid.Row="1" Name="FrameMain" NavigationUIVisibility="Hidden"/>
        <Frame Grid.Row="0" Name="TopBar" Background="LightSeaGreen"/>
        <TextBlock Text="чудо обувь" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" Margin="30, 0, 0, 0"/>
    </Grid>
</Window>
